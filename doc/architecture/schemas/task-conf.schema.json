{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-conf.schema.json",
  "title": "Task configuration and plan policy",
  "oneOf": [
    {"$ref": "#/$defs/planDefaults"},
    {"$ref": "#/$defs/typeConfig"}
  ],
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["section_present", "section_min_items", "link_min", "table_column", "case_min", "command"]},
        "section": {"type": "string", "minLength": 1},
        "column": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "min": {"type": "integer", "minimum": 1},
        "when": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          ]
        }
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "section_present"}}, "required": ["kind"]}, "then": {"required": ["section"]}},
        {"if": {"properties": {"kind": {"const": "section_min_items"}}, "required": ["kind"]}, "then": {"required": ["section", "min"]}},
        {"if": {"properties": {"kind": {"const": "link_min"}}, "required": ["kind"]}, "then": {"required": ["section", "min"]}},
        {"if": {"properties": {"kind": {"const": "table_column"}}, "required": ["kind"]}, "then": {"required": ["section", "column"]}},
        {"if": {"properties": {"kind": {"const": "case_min"}}, "required": ["kind"]}, "then": {"required": ["min"]}},
        {"if": {"properties": {"kind": {"const": "command"}}, "required": ["kind"]}, "then": {"required": ["command"]}}
      ],
      "additionalProperties": true
    },
    "tier": {
      "type": "object",
      "required": ["complexity", "required_sections", "template"],
      "properties": {
        "complexity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["low", "medium", "high", "critical"]}},
        "required_sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "template": {"type": "string", "minLength": 1},
        "max_nonempty_lines": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["tiers", "acceptance"],
      "properties": {
        "plan_policy": {"enum": ["inherit", "replace"]},
        "tiers": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/tier"}},
        "acceptance": {
          "type": "object",
          "required": ["profile", "rules"],
          "properties": {
            "profile": {"type": "string", "minLength": 1},
            "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "planDefaults": {
      "type": "object",
      "required": ["schema_version", "tiers", "acceptance"],
      "properties": {
        "schema_version": {"const": "plan-policy-1"},
        "tiers": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/tier"}},
        "acceptance": {"type": "object", "required": ["profile", "rules"], "additionalProperties": true},
        "safety_floor": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "typeConfig": {
      "type": "object",
      "required": ["id", "plan"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "selectable": {"type": "boolean"},
        "plan": {"$ref": "#/$defs/policy"}
      },
      "additionalProperties": true
    }
  }
}
